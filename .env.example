# Variables de entorno de Crumble (una instalación por cliente).
# Solo nombres: NUNCA pongas valores reales aquí ni en ningún archivo del repositorio.
# En local, copia este archivo a .env.local y llénalo. En Railway, se cargan en las variables del servicio.
# Fuente: docs/proyectos/crumble/diseno-tecnico.md, sección 5.7, y docs/estandares/soporte.md
# (en wiqi20/STICR_landingpage).

# --- Base de datos ---
# Postgres de la instalación (en Railway, la dirección de la red privada).
DATABASE_URL=

# --- Direcciones de la instalación ---
# Dirección pública de la tienda y del panel, con https y sin barra final.
# Se usan para enrutar por Host, comprobar Origin exacto y armar el retorno de Google.
URL_TIENDA=
URL_PANEL=

# --- Inicio de sesión con Google (no se usan en la demo) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sesión ---
# Firma del estado del inicio de sesión. Largo y aleatorio, distinto en cada instalación.
SESSION_SECRET=

# --- Primera propietaria (se crea al instalar) ---
PROPIETARIA_EMAIL=

# --- Privacidad ---
# Sal del resumen de la IP. Larga y aleatoria, distinta en cada instalación.
IP_HASH_SALT=
# Meses tras los que se borran los datos personales de los pedidos.
RETENCION_PEDIDOS_MESES=

# --- Demo ---
# true solo en la instalación de demostración (pasteleria-demo).
MODO_DEMO=
# Cada cuántos minutos se restablece la demo (el diseño pide 60).
DEMO_RESET_MINUTOS=

# --- Estado del servicio ---
# activo o suspendido. Lo cambia solo el dueño de STI.
ESTADO_SERVICIO=

# --- Soporte: botón «Reportar un problema» (docs/estandares/soporte.md) ---
# Dirección de la recepción de reportes en sticr.app.
SOPORTE_URL=
# Origen de esta instalación: crumble en la tienda de Crumble, pasteleria-demo en la demo.
SOPORTE_ORIGEN=
# Secreto de esta instalación (mínimo 32 bytes aleatorios); igual al SOPORTE_SECRETO_<ORIGEN> de sticr.app.
SOPORTE_SECRETO=

# --- Solo para pruebas en local y en CI (no se carga en Railway) ---
# Base LOCAL de pruebas cuyo nombre termina en _test. Las pruebas la vacían y la recrean.
TEST_DATABASE_URL=
